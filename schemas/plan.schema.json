{
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "enum": [
        "gemini-review/2"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "proposal": {
      "type": "string",
      "minLength": 1
    },
    "critical_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verification_requirement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "claim",
          "verification_requirement"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "task_kind": {
      "type": "string",
      "enum": [
        "research",
        "planning",
        "implementation"
      ]
    },
    "source_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol",
    "task_id",
    "question_sha256",
    "version",
    "proposal",
    "critical_assumptions",
    "failure_modes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
