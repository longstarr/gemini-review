{
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "enum": [
        "gemini-review/2"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "adversarial",
        "final"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "required_fix": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "issue",
          "trigger",
          "evidence",
          "required_fix"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "verification_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assumption_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "SATISFIED",
              "USER_ACCEPTED_UNVERIFIED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "assumption_ids",
          "request",
          "status",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "tradeoff"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "critical_assumptions_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "REJECTED",
        "CONDITIONAL_PASS",
        "APPROVED"
      ]
    },
    "end_marker": {
      "type": "string",
      "enum": [
        "END_REVIEW"
      ]
    }
  },
  "required": [
    "protocol",
    "task_id",
    "request_id",
    "plan_sha256",
    "round",
    "phase",
    "complete",
    "blockers",
    "verification_requests",
    "divergences",
    "critical_assumptions_checked",
    "verdict",
    "end_marker"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
