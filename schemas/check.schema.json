{
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "enum": [
        "gemini-review/2"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "assumption_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "command",
        "web",
        "literature"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time"
          },
          "supports": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "title",
          "accessed_at",
          "supports",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "protocol",
    "task_id",
    "plan_sha256",
    "id",
    "assumption_ids",
    "method",
    "executed_at",
    "target",
    "expected",
    "observed",
    "status",
    "artifact",
    "artifact_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
